    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/gapi": "^0.0.47",
    "@types/google.accounts": "^0.0.14",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
